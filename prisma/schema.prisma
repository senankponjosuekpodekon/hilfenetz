generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DONOR
  REQUESTER
}

enum OfferStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
  CLOSED
  ARCHIVED
}

enum Category {
  SOCIAL
  PROFESSIONAL
  COMMUNITY
}

enum RequestStatus {
  RECEIVED
  UNDER_REVIEW
  VALIDATED
  PRESENTED
  MATCHED
  CLOSED
  REJECTED
}

enum ProposalStatus {
  NEW
  UNDER_REVIEW
  PROCESSED
  REJECTED
}

enum ReportStatus {
  NEW
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum ReportReason {
  MISLEADING_INFO
  PAYMENT_REQUEST
  SUSPICIOUS_BEHAVIOR
  SUSPECTED_FRAUD
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DonationOffer {
  id           String           @id @default(cuid())
  title        String
  description  String
  donorMessage String?
  amount       Decimal          @db.Decimal(12, 2)
  currency     String           @default("EUR")
  category     Category
  criteria     String?
  status       OfferStatus      @default(PENDING_REVIEW)
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  requests     SupportRequest[]
  reports      Report[]
}

model SupportRequest {
  id                 String        @id @default(cuid())
  reference          String        @unique
  firstName          String
  lastName           String
  email              String
  phone              String
  country            String
  projectDescription String
  donorMessage       String?
  status             RequestStatus @default(RECEIVED)
  internalNote       String?
  offerId            String?
  offer              DonationOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model DonationProposal {
  id           String         @id @default(cuid())
  name         String
  organization String?
  email        String
  phone        String?
  amount       Decimal        @db.Decimal(12, 2)
  currency     String         @default("EUR")
  supportType  String
  criteria     String
  message      String
  status       ProposalStatus @default(NEW)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Report {
  id          String       @id @default(cuid())
  offerName   String
  offerUrl    String
  offerId     String?
  offer       DonationOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  reason      ReportReason
  description String
  email       String
  status      ReportStatus @default(NEW)
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}
